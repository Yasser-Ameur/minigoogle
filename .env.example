# MiniGoogle environment variables. Copy to .env and adjust, or pass -e flags
# to `docker run`. Every variable here is read by ConfigurationLoader; each
# maps to a key in config/application.yaml and env always wins over the file.
#
# Unprefixed aliases (NODE_TYPE, NODE_PORT, NODE_ID, CLUSTER_PEERS,
# CLUSTER_PORT, CLUSTER_SECRET, ADVERTISED_HOST, INDEX_DIR) are also read, for
# container orchestrators that set plain names; the MINIGOGLE_-prefixed name
# wins when both are set. Only the MINIGOGLE_-prefixed form is listed below.

# API key required on protected routes (POST /api/v1/crawl), sent as
# "X-API-Key: <key>" or "Authorization: Bearer <key>". Empty leaves the route
# open. No default: set this before exposing the service to a network.
MINIGOGLE_API_KEY=

# Node role: STANDALONE (single process, local index), SEARCH (index node that
# registers with a coordinator), COORDINATOR (fans queries out, hosts no local
# index), CLUSTER (full search node that also runs gossip and Raft).
MINIGOGLE_NODE_TYPE=STANDALONE

# Port the public REST API listens on.
MINIGOGLE_NODE_PORT=8080

# Host/interface the REST API binds to.
MINIGOGLE_NODE_HOST=0.0.0.0

# Directory holding the crawled index and, in CLUSTER mode, Raft state.
MINIGOGLE_INDEX_DIR=demo-index

# Stable id of this cluster member (CLUSTER mode). Defaults to unset; the app
# derives one when empty.
MINIGOGLE_NODE_ID=

# Comma-separated peer list as nodeId=http://host:port pairs (CLUSTER mode).
MINIGOGLE_CLUSTER_PEERS=

# Internal cluster RPC port (gossip, Raft, and the COORDINATOR registry port).
MINIGOGLE_CLUSTER_PORT=8081

# URL a SEARCH node registers with; defaults to http://localhost:<cluster.port>
# when empty.
MINIGOGLE_CLUSTER_COORDINATOR_URL=

# Number of copies each piece of data is kept at across the cluster.
MINIGOGLE_REPLICATION_FACTOR=3

# Shared secret peers must present to accept each other's cluster RPCs.
MINIGOGLE_CLUSTER_SECRET=

# Hostname/IP this node advertises to peers (CLUSTER mode).
MINIGOGLE_ADVERTISED_HOST=localhost

# Root logger level (e.g. INFO, DEBUG, WARN).
MINIGOGLE_LOG_LEVEL=INFO
