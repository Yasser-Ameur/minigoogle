# Build output. Anchored to the repository root: a bare `build/` also matches
# any nested directory of that name, which silently excluded the Java package
# src/test/java/com/minigoogle/build/ -- DockerfileConsistencyTest was never
# committed and never ran in CI.
/build/
/.gradle/
/out/
/bin/

# IDE
.idea/
*.iml
*.ipr
*.iws
.classpath
.project
.settings/
.vscode/

# OS
.DS_Store
Thumbs.db

# Logs
*.log

# Runtime data
demo-index/
demo-index-a/
demo-index-b/
snapshots/
data/

# Gradle wrapper (keep JAR)
!gradle/wrapper/gradle-wrapper.jar

# Frontend
frontend/node_modules/
frontend/dist/

# Downloaded ML model artifacts. Fetched on demand by SentenceEncoder with a
# SHA-256 check; never committed - all-MiniLM-L6-v2 alone is 90 MB.
/models/
